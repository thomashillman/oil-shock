{
  "name": "oil-shock",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "workerd"]
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "lint": "corepack pnpm -r --if-present lint",
    "test": "corepack pnpm -r --if-present test",
    "dev:worker": "corepack pnpm --filter @oil-shock/worker dev",
    "dev:web": "corepack pnpm --filter @oil-shock/app dev",
    "db:migrate:local": "tsx scripts/apply-all-migrations.ts --local",
    "db:migrate:local:reset": "tsx scripts/reset-local-d1-state.ts",
    "poc:run": "corepack pnpm db:migrate:local && corepack pnpm build",
    "backfill:eia-energy": "tsx scripts/backfill-eia-energy.ts",
    "backfill:eia-inventory": "tsx scripts/backfill-eia-inventory.ts",
    "backfill:eia-futures-curve": "tsx scripts/backfill-eia-futures-curve.ts",
    "backfill:eia-refinery": "tsx scripts/backfill-eia-refinery.ts",
    "backfill:gie-storage": "tsx scripts/backfill-gie-storage.ts",
    "replay:validate": "tsx scripts/replay-validate.ts",
    "docs:check": "node scripts/docs-check.mjs",
    "ci:preflight": "corepack pnpm lint && corepack pnpm -r --if-present typecheck && corepack pnpm test && corepack pnpm phase6a:evidence:test && corepack pnpm build",
    "phase6a:evidence": "tsx scripts/phase6a/capture-canary-evidence.ts",
    "phase6a:evidence:test": "corepack pnpm -C worker exec vitest run test/phase6a",
    "phase6a:d1:preflight": "tsx scripts/phase6a/check-d1-target.ts"
  }
}
